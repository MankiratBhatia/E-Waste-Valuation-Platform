# ============================================================
# Terionix-MRIS Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Database
# Dev (SQLite):
DATABASE_URL=sqlite:///./terionix.db
# Prod (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/terionix_prod

# API
API_HOST=0.0.0.0
API_PORT=8000

# Admin API Key (protects SVI and supplier intelligence endpoints)
ADMIN_API_KEY=change-me-super-secret-key

# FastAPI Base URL (used by Streamlit frontend)
API_BASE_URL=http://localhost:8000

# Environment
ENVIRONMENT=development
